# ─────────────────────────────────────────────────────────────
# TIERRA ACADEMY — environment variables
# Copy to .env.local for development. NEVER commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets in them.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave empty for preview deployments; set to /academy when served at tierraautomation.in/academy (build-time!)
NEXT_PUBLIC_BASE_PATH=
# "demo" shows DEMO banners and enables simulated providers. Set to "production" only after all providers are configured.
APP_MODE=demo

# Database (PostgreSQL / Supabase). Use the Supabase *transaction pooler* URL (port 6543) in serverless.
DATABASE_URL=postgres://tierra:tierra_dev@127.0.0.1:5432/tierra_academy
DB_POOL_MAX=5
# Set to "true" when DATABASE_URL points at a Supabase project (auth schema/roles already exist)
DB_IS_SUPABASE=false

# Sessions — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-64-random-characters-minimum-32-characters-long
# Encrypts MFA secrets at rest (32+ chars)
DATA_ENCRYPTION_KEY=replace-with-another-long-random-secret-value

# Auth provider: "local" (passwords hashed in the app DB) or "supabase" (Supabase Auth / GoTrue)
AUTH_PROVIDER=local
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REQUIRE_ADMIN_MFA=false

# One-time Super Admin provisioning (see docs/SECURITY.md). Remove after use.
SUPER_ADMIN_SETUP_TOKEN=

# Payments: "demo" (simulated, no money moves) or "razorpay"
PAYMENTS_PROVIDER=demo
DEMO_PAYMENT_WEBHOOK_SECRET=local-demo-webhook-secret-change-me
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Live classes: "demo" (simulated classroom, NOT a real conference) or "zoom"
LIVE_PROVIDER=demo
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# Recorded video: "local" (dev disk storage + bundled synthetic samples) or "cloudflare"
VIDEO_PROVIDER=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# File storage for thumbnails/PDFs: "local" (dev only) or "supabase"
STORAGE_PROVIDER=local
SUPABASE_STORAGE_BUCKET_PUBLIC=academy-public
SUPABASE_STORAGE_BUCKET_PRIVATE=academy-private

# Email: "outbox" (stored in DB, visible at /admin/outbox) or "resend"
EMAIL_PROVIDER=outbox
EMAIL_FROM="Tierra Academy <academy@tierraautomation.in>"
RESEND_API_KEY=

# Rate limiting: in-memory by default; set Upstash for multi-instance deployments
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron authorization for /api/cron/*
CRON_SECRET=

# Monitoring (optional) — any Sentry-compatible DSN; errors are logged to stdout otherwise
ERROR_WEBHOOK_URL=
